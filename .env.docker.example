# ===================================================
# Docker 部署环境配置
# ===================================================
# 复制此文件为 .env.docker 并修改配置
# docker-compose 会自动读取此文件注入容器环境变量

# 环境标识
ENV=production
DEBUG=False

# 应用信息
VERSION=0.1.0
APP_TITLE=Vue FastAPI Admin
PROJECT_NAME=Vue FastAPI Admin
APP_DESCRIPTION=Description

# CORS 配置
CORS_ORIGINS=["*"]
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# 安全配置（生产环境请更换 SECRET_KEY）
SECRET_KEY=3488a63e1765035d386f05409663f55c83bfae3b3c61a932744b20ad14244dcf
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ===================================================
# 数据库配置
# ===================================================
# 连接宿主机(Windows)上的 PostgreSQL:
#   DB_HOST=host.docker.internal
# 连接容器内数据库(with-db profile):
#   DB_HOST=db
# 连接远程数据库:
#   DB_HOST=your-remote-host.com
DB_HOST=host.docker.internal
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=tx_agent_admin

# ===================================================
# 飞书配置
# ===================================================
FEISHU_BASE_URL=https://open.feishu.cn/open-apis
FEISHU_STRUCTURED_FOLDER_TOKEN=
FEISHU_VERIFY_SSL=True

# ===================================================
# LlamaIndex / RAG 配置
# ===================================================
VECTOR_STORE_TABLE_NAME=knowledge_chunks
DEFAULT_EMBEDDING_DIMENSION=1536

# ===================================================
# LangChain / LLM 配置
# ===================================================
LLM_PROVIDER=openai
LLM_MODEL_NAME=gpt-4
LLM_API_KEY=
LLM_BASE_URL=
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4000

# ===================================================
# Gotenberg 文档转换服务
# ===================================================
# Docker 环境下使用容器名:
#   GOTENBERG_URL=http://gotenberg:3000
# 本地开发环境（Gotenberg 通过 docker 单独运行）:
#   GOTENBERG_URL=http://localhost:3000
GOTENBERG_URL=http://gotenberg:3000
