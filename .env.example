# ===================================================
# Vue FastAPI Admin 环境配置
# ===================================================

# 环境标识
ENV=development
DEBUG=True

# 应用信息
VERSION=0.1.0
APP_TITLE=Vue FastAPI Admin
PROJECT_NAME=Vue FastAPI Admin
APP_DESCRIPTION=Description

# CORS 配置
CORS_ORIGINS=["*"]
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# 安全配置
SECRET_KEY=3488a63e1765035d386f05409663f55c83bfae3b3c61a932744b20ad14244dcf
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ===================================================
# 数据库配置
# ===================================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=tx_agent_admin

# ===================================================
# 飞书配置
# ===================================================
FEISHU_BASE_URL=https://open.feishu.cn/open-apis
FEISHU_STRUCTURED_FOLDER_TOKEN=
FEISHU_DOC_BOT_APPID=
FEISHU_DOC_BOT_APPSECRET=

# ===================================================
# LlamaIndex / RAG 配置
# ===================================================
VECTOR_STORE_TABLE_NAME=knowledge_chunks
DEFAULT_EMBEDDING_DIMENSION=1536

# ===================================================
# LangChain / LLM 配置
# ===================================================
LLM_PROVIDER=openai
LLM_MODEL_NAME=gpt-4
LLM_API_KEY=
LLM_BASE_URL=
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4000

# ===================================================
# Gotenberg 文档转换服务
# ===================================================
# 本地开发：先运行 docker run -d -p 3000:3000 gotenberg/gotenberg:8
GOTENBERG_URL=http://localhost:3000

# ===================================================
# 文件存储 / 火山引擎 TOS
# ===================================================
# FILE_STORAGE_BACKEND=local 时使用本地媒体目录；=tos 时启用火山 TOS
FILE_STORAGE_BACKEND=local
TOS_ENDPOINT=
TOS_REGION=
TOS_ACCESS_KEY=
TOS_SECRET_KEY=
TOS_BUCKET=

# 飞书 IM image_key 缓存（避免同一页截图重复上传）
# backend: memory(单进程内存) | redis(待实现)
IMAGE_KEY_CACHE_BACKEND=memory
IMAGE_KEY_CACHE_MAX_SIZE=1024
IMAGE_KEY_CACHE_TTL=604800

# ===================================================
# 火山引擎 OCR（智能文档解析）
# ===================================================
# PDF 文档通过火山引擎 OCR 服务解析为 Markdown
# 获取方式: 火山引擎控制台 -> 右上角头像 -> 访问控制 -> API 访问密钥
VOLC_AK=
VOLC_SK=
# OCR 调用失败最大重试次数（指数退避: 2s → 4s → 8s）
VOLC_OCR_MAX_RETRIES=3
# 重试基础等待秒数
VOLC_OCR_RETRY_DELAY=2.0
